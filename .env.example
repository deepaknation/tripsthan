# =============================================================================
# TripSthan Environment Variables
# =============================================================================

# Primary destination for contact form enquiries (default: info@tripsthan.com)
CONTACT_RECEIVER_EMAIL=info@tripsthan.com

# Admin secret key for accessing /api/contact enquiries endpoint in production
ADMIN_SECRET=tripsthan_admin_secret_key

# Optional: Resend API Key for automatic HTML email forwarding
# RESEND_API_KEY=re_1234567890abcdef

# Optional: Custom Webhook URL for CRM / Slack / Zapier lead alerts
# EMAIL_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...

# Optional: Sender email address (if using custom domain verified on Resend)
# EMAIL_FROM=TripSthan Private Tours <info@tripsthan.com>
